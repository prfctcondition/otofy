{
  "name": "otofy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron:dev": "npm run build:preload && tsc -p tsconfig.electron.json && concurrently \"vite --port=3000\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && npm run build:preload",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "dist": "npm run build && tsc -p tsconfig.electron.json && npm run build:preload && electron-builder --win"
  },
  "build": {
    "appId": "com.otofy.desktop",
    "productName": "Otofy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "artifactName": "${productName} Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Otofy"
    }
  },
  "dependencies": {
    "@capacitor/core": "^7.2.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.0.11",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "music-metadata": "^11.15.0",
    "pako": "^2.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "scdl-core": "^1.1.0",
    "vite": "^6.2.3",
    "youtubei.js": "^18.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.14.0",
    "@types/pako": "^2.0.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.3"
  }
}
